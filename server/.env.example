# 이 파일을 복사해 .env 로 만들고 실제 키를 넣으세요. .env 는 절대 커밋하지 마세요.
#   cp .env.example .env
#
# Anthropic API 키 (반드시 서버에만 보관, 브라우저/저장소 금지)
ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# 프록시 포트 (선택, 기본 8787)
PORT=8787
