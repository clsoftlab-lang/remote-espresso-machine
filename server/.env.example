#
# 이 파일을 복사해 .env 로 만들고 실제 키를 넣으세요. .env 는 절대 커밋하지 마세요.
#   cp .env.example .env
#
# Anthropic API 키 (반드시 서버에만 보관, 브라우저/저장소 금지)
ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# 프록시 포트 (선택, 기본 8787)
PORT=8787

# --- 비용/동작 튜닝 (모두 선택) ---
# 비용 우선 기본 모델. 품질 우선이면 claude-sonnet-5 / claude-opus-5 로 상향.
AI_MODEL=claude-haiku-4-5
# 비-haiku 모델에서만 적용되는 추론 강도(low/medium/high).
AI_EFFORT=low
# 태스크별 출력 토큰 상한.
AI_MAX_TOKENS=700
# IP당 분당 요청 상한.
AI_RATE_LIMIT=20
# 월 토큰 예산(초과 시 429 {fallback:true} → 프론트 Mock 폴백).
AI_MONTHLY_TOKEN_CAP=2000000
